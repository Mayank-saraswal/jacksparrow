// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model CorsairIntegration {
  id        String           @id
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  name      String
  config    Json             @default("{}")
  dek       String?
  accounts  CorsairAccount[]

  @@map("corsair_integrations")
}

model CorsairAccount {
  id            String             @id
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  tenantId      String             @map("tenant_id")
  integrationId String             @map("integration_id")
  config        Json               @default("{}")
  dek           String?
  integration   CorsairIntegration @relation(fields: [integrationId], references: [id])
  entities      CorsairEntity[]
  events        CorsairEvent[]

  @@index([integrationId])
  @@index([tenantId])
  @@index([tenantId, integrationId])
  @@map("corsair_accounts")
}

model CorsairEntity {
  id         String         @id
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  accountId  String         @map("account_id")
  entityId   String         @map("entity_id")
  entityType String         @map("entity_type")
  version    String
  data       Json           @default("{}")
  account    CorsairAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([accountId, entityType])
  @@index([entityId])
  @@map("corsair_entities")
}

model CorsairEvent {
  id        String         @id
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  accountId String         @map("account_id")
  eventType String         @map("event_type")
  payload   Json           @default("{}")
  status    String?
  account   CorsairAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("corsair_events")
}


// ─────────────────────────────────────────────────────────────────────────────
// App models (Phase 2) — everything Corsair doesn't track for us.
// `User` is keyed by the Clerk user id (same value used as the Corsair tenant).
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                   String    @id
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  gmailBackfilledAt    DateTime? @map("gmail_backfilled_at") @db.Timestamptz
  calendarBackfilledAt DateTime? @map("calendar_backfilled_at") @db.Timestamptz
  outlookBackfilledAt  DateTime? @map("outlook_backfilled_at") @db.Timestamptz
  deletionScheduledAt  DateTime? @map("deletion_scheduled_at") @db.Timestamptz

  channelLinks    ChannelLink[]
  emailEmbeddings EmailEmbedding[]
  priorityScores  PriorityScore[]
  pendingActions  PendingAction[]
  preference      UserPreference?
  snoozedThreads  SnoozedThread[]
  scheduledEmails ScheduledEmail[]
  followUps       FollowUp[]
  sentSamples      SentMessageSample[]
  styleProfile     StyleProfile?
  threadSummaries  ThreadSummary[]
  triageFeedback   TriageFeedback[]
  senderAffinities SenderAffinity[]
  ruleSuggestions  RuleSuggestion[]
  meetingSummaries MeetingSummary[]
  chatConversations ChatConversation[]

  @@map("users")
}

model ChannelLink {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  channel        String // "telegram" | "whatsapp"
  externalChatId String   @map("external_chat_id")
  linkedAt       DateTime @default(now()) @map("linked_at") @db.Timestamptz
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channel, externalChatId])
  @@index([userId])
  @@map("channel_links")
}

model EmailEmbedding {
  id              String                       @id @default(cuid())
  userId          String                       @map("user_id")
  corsairEntityId String                       @map("corsair_entity_id")
  threadId        String                       @map("thread_id")
  subjectSnippet  String                       @map("subject_snippet")
  contentHash     String?                      @map("content_hash")
  embedding       Unsupported("vector(1536)")?
  indexedAt       DateTime                     @default(now()) @map("indexed_at") @db.Timestamptz
  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, corsairEntityId])
  @@index([userId])
  @@index([corsairEntityId])
  @@index([threadId])
  @@map("email_embeddings")
}

model PriorityScore {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  corsairEntityId String   @map("corsair_entity_id")
  threadId        String   @map("thread_id")
  label           String // "urgent" | "important" | "normal" | "low"
  reason          String?
  model           String?
  source          String   @default("llm") // "llm" | "manual"
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId])
  @@index([corsairEntityId])
  @@map("priority_scores")
}

model PendingAction {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  channel              String // "web" | "telegram" | "whatsapp"
  kind                 String
  draftPayload         Json      @default("{}") @map("draft_payload")
  corsairOperationPath String?   @map("corsair_operation_path")
  status               String    @default("pending") // pending|approved|rejected|executed
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt           DateTime? @map("resolved_at") @db.Timestamptz
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("pending_actions")
}

model UserPreference {
  id                String @id @default(cuid())
  userId            String @unique @map("user_id")
  splitInboxRules   Json   @default("{}") @map("split_inbox_rules")
  shortcutOverrides Json   @default("{}") @map("shortcut_overrides")
  undoSendSeconds   Int    @default(10) @map("undo_send_seconds")
  followUpDays      Int    @default(3) @map("follow_up_days")
  // Which mail backend drives the inbox when both Gmail + Outlook are connected.
  primaryMailPlugin String @default("gmail") @map("primary_mail_plugin")
  // Phase 3 — preferred provider when multiple of a kind are connected.
  defaultTaskProvider       String? @map("default_task_provider")
  defaultSchedulingProvider String? @map("default_scheduling_provider")
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model SnoozedThread {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  threadId        String    @map("thread_id")
  corsairEntityId String    @map("corsair_entity_id")
  snoozeUntil     DateTime  @map("snooze_until") @db.Timestamptz
  status          String    @default("snoozed") // snoozed | woken | canceled
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  wokenAt         DateTime? @map("woken_at") @db.Timestamptz
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId])
  @@index([status])
  @@map("snoozed_threads")
}

model ScheduledEmail {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  draftPayload Json      @map("draft_payload")
  sendAt       DateTime  @map("send_at") @db.Timestamptz
  status       String    @default("scheduled") // scheduled | sent | canceled | failed
  inngestRunId String?   @map("inngest_run_id")
  error        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  sentAt       DateTime? @map("sent_at") @db.Timestamptz
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("scheduled_emails")
}

model FollowUp {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  threadId   String   @map("thread_id")
  lastSentAt DateTime @map("last_sent_at") @db.Timestamptz
  remindAt   DateTime @map("remind_at") @db.Timestamptz
  status     String   @default("watching") // watching | reminded | replied | dismissed
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId])
  @@index([status, remindAt])
  @@map("follow_ups")
}

// Lightweight, realtime-friendly feed of changed entities (emails + events).
// Written by the webhook → Inngest pipeline; clients subscribe via Supabase
// Realtime and merge new rows into list views without a full refetch.
model SyncItem {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  orgId           String?  @map("org_id")
  sharedInboxId   String?  @map("shared_inbox_id")
  corsairEntityId String   @map("corsair_entity_id")
  type            String // "email" | "event" | "slack"
  title           String
  snippet         String
  // List-rendering fields so the inbox can be served from SyncItem without a
  // live provider round-trip (Phase 0, Fix 1).
  threadId        String?  @map("thread_id")
  fromName        String?  @map("from_name")
  fromEmail       String?  @map("from_email")
  unread          Boolean  @default(false)
  starred         Boolean  @default(false)
  timestamp       DateTime @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, corsairEntityId])
  @@index([userId, timestamp])
  @@index([userId, type, timestamp])
  @@index([orgId, timestamp])
  @@index([sharedInboxId, timestamp])
  @@map("sync_items")
}

// Short-lived code used to link a Telegram/WhatsApp chat to a user account.
model LinkCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String   @map("user_id")
  channel   String // "telegram" | "whatsapp"
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("link_codes")
}


// ─────────────────────────────────────────────────────────────────────────────
// Phase 2 — AI Moat
// ─────────────────────────────────────────────────────────────────────────────

// Plain-text samples of the user's own sent mail, used as few-shot style
// references for voice-matched drafts. Embedded for nearest-neighbour retrieval.
model SentMessageSample {
  id              String                       @id @default(cuid())
  userId          String                       @map("user_id")
  corsairEntityId String                       @map("corsair_entity_id")
  threadId        String                       @map("thread_id")
  toDomain        String                       @map("to_domain")
  bodyText        String                       @map("body_text")
  wordCount       Int                          @map("word_count")
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, corsairEntityId])
  @@index([userId])
  @@index([userId, toDomain])
  @@map("sent_message_samples")
}

// A structured, LLM-derived description of how the user writes. Regenerated as
// the sample count crosses thresholds.
model StyleProfile {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  summary     Json     @default("{}")
  sampleCount Int      @default(0) @map("sample_count")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("style_profiles")
}

// Cached per-thread summaries, keyed by the thread's corsair entity version so
// stale summaries are detectable without re-summarizing.
model ThreadSummary {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  threadId            String   @map("thread_id")
  entityVersion       String   @map("entity_version")
  summary             String
  keyPoints           Json     @default("[]") @map("key_points")
  actionItems         Json     @default("[]") @map("action_items")
  unansweredQuestions Json     @default("[]") @map("unanswered_questions")
  model               String?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId, entityVersion])
  @@index([userId, threadId])
  @@map("thread_summaries")
}

// Raw behavioral signals feeding learned triage. Append-only; aggregated into
// SenderAffinity.
model TriageFeedback {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  threadId   String   @map("thread_id")
  fromEmail  String   @map("from_email")
  fromDomain String   @map("from_domain")
  signal     String
  weight     Float
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, fromDomain])
  @@index([userId, fromEmail])
  @@map("triage_feedback")
}

// Decayed affinity score per sender (email or domain). key is prefixed
// "email:" or "domain:".
model SenderAffinity {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  key         String
  score       Float    @default(0)
  signalCount Int      @default(0) @map("signal_count")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("sender_affinities")
}

// Proposed automation rules surfaced to the user (human-in-the-loop). Never
// auto-applied.
model RuleSuggestion {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  kind      String // "mute" | "vip" | "split"
  payload   Json     @default("{}")
  status    String   @default("proposed") // proposed | accepted | dismissed
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("rule_suggestions")
}


// ─────────────────────────────────────────────────────────────────────────────
// Phase 3 — Teams: organizations, shared inboxes, billing
//
// Clerk Organizations are the identity source; Organization/Membership mirror
// them locally for joins. Org-shared accounts use the Corsair tenant
// `org:{orgId}`; personal accounts stay per-user.
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id // Clerk organization id
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Org-level backfill completion timestamps (mirrors User.*BackfilledAt).
  // null = currently syncing; set = last sync completed at this time.
  gmailBackfilledAt    DateTime? @map("gmail_backfilled_at") @db.Timestamptz
  outlookBackfilledAt  DateTime? @map("outlook_backfilled_at") @db.Timestamptz

  // Org toggle: when off, analytics show org totals only (no per-member rows).
  memberLevelAnalytics Boolean @default(true) @map("member_level_analytics")

  // Phase 2: which provider the generic "create issue" / meeting tools prefer
  // when more than one is connected for the org.
  defaultIssueTracker String? @map("default_issue_tracker")
  defaultMeetingProvider String? @map("default_meeting_provider")
  // Phase 3: preferred support desk (zendesk/intercom) when both connected.
  defaultSupportProvider String? @map("default_support_provider")

  memberships     Membership[]
  sharedInboxes   SharedInbox[]
  ssoConnections  SsoConnection[]
  retentionPolicy RetentionPolicy?
  legalHolds      LegalHold[]
  dailyStats      DailyOrgStat[]

  @@map("organizations")
}

model Membership {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  userId    String   @map("user_id")
  role      String   @default("member") // "admin" | "member"
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

// An org-owned email account every member can triage collaboratively.
model SharedInbox {
  id                String   @id @default(cuid())
  orgId             String   @map("org_id")
  name              String
  plugin            String // "gmail" | "outlook"
  corsairAccountId  String?  @map("corsair_account_id")
  connectedByUserId String   @map("connected_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignments  ThreadAssignment[]
  comments     ThreadComment[]
  events       AssignmentEvent[]

  @@index([orgId])
  @@map("shared_inboxes")
}

model ThreadAssignment {
  id             String   @id @default(cuid())
  sharedInboxId  String   @map("shared_inbox_id")
  threadId       String   @map("thread_id")
  assigneeUserId String?  @map("assignee_user_id")
  status         String   @default("open") // open | assigned | snoozed | closed
  // Phase 3 — link to an external support ticket (Zendesk/Intercom).
  supportProvider String? @map("support_provider")
  supportTicketId String? @map("support_ticket_id")
  updatedByUserId String  @map("updated_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sharedInbox SharedInbox @relation(fields: [sharedInboxId], references: [id], onDelete: Cascade)

  @@unique([sharedInboxId, threadId])
  @@index([sharedInboxId, status])
  @@index([assigneeUserId])
  @@map("thread_assignments")
}

// Internal notes on a shared-inbox thread — never emailed to the correspondent.
model ThreadComment {
  id            String   @id @default(cuid())
  sharedInboxId String   @map("shared_inbox_id")
  threadId      String   @map("thread_id")
  authorUserId  String   @map("author_user_id")
  body          String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  sharedInbox SharedInbox @relation(fields: [sharedInboxId], references: [id], onDelete: Cascade)

  @@index([sharedInboxId, threadId])
  @@map("thread_comments")
}

// Phase 3 — structured summary of an external meeting (Fireflies transcript).
// Reuses the same summarizer as email threads; action items spawn FollowUps.
model MeetingSummary {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  meetingId     String   @map("meeting_id")
  source        String   @default("fireflies")
  title         String   @default("")
  tldr          String
  keyPoints     Json     @default("[]") @map("key_points")
  actionItems   Json     @default("[]") @map("action_items")
  attendees     Json     @default("[]")
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz
  model         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, meetingId])
  @@index([userId, occurredAt])
  @@map("meeting_summaries")
}

// Audit trail of everything that happened on a shared-inbox thread.
model AssignmentEvent {
  id            String   @id @default(cuid())
  sharedInboxId String   @map("shared_inbox_id")
  threadId      String   @map("thread_id")
  actorUserId   String   @map("actor_user_id")
  kind          String // assigned | unassigned | closed | reopened | commented | replied
  meta          Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  sharedInbox SharedInbox @relation(fields: [sharedInboxId], references: [id], onDelete: Cascade)

  @@index([sharedInboxId, threadId])
  @@map("assignment_events")
}

// ── Billing (Dodo Payments) ──────────────────────────────────────────────────

model BillingCustomer {
  id             String   @id @default(cuid())
  ownerType      String   @map("owner_type") // "user" | "org"
  ownerId        String   @map("owner_id")
  dodoCustomerId String   @unique @map("dodo_customer_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  subscriptions Subscription[]

  @@unique([ownerType, ownerId])
  @@map("billing_customers")
}

model Subscription {
  id                 String    @id @default(cuid())
  billingCustomerId  String    @map("billing_customer_id")
  dodoSubscriptionId String    @unique @map("dodo_subscription_id")
  plan               String // "free" | "pro" | "business" | "enterprise"
  status             String // active | on_hold | cancelled | expired | ...
  seats              Int       @default(1)
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  billingCustomer BillingCustomer @relation(fields: [billingCustomerId], references: [id], onDelete: Cascade)

  @@index([billingCustomerId])
  @@map("subscriptions")
}

// Monthly metered usage buckets, incremented atomically.
model UsageRecord {
  id          String   @id @default(cuid())
  ownerType   String   @map("owner_type")
  ownerId     String   @map("owner_id")
  userId      String   @map("user_id")
  metric      String // "ai_action" | "embedding" | "summary"
  count       Int      @default(0)
  periodStart DateTime @map("period_start") @db.Timestamptz

  @@unique([ownerType, ownerId, userId, metric, periodStart])
  @@index([ownerType, ownerId])
  @@map("usage_records")
}

// Dedupe table for Dodo Payments webhook idempotency.
model WebhookEvent {
  id          String   @id // Dodo webhook event id
  type        String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@map("webhook_events")
}


// ─────────────────────────────────────────────────────────────────────────────
// Phase 4 — Enterprise: audit logs, SSO, retention, analytics
// ─────────────────────────────────────────────────────────────────────────────

// Append-only, queryable trail of security-relevant actions. A Postgres trigger
// (shipped in the same migration) raises on UPDATE/DELETE as defense-in-depth;
// no app code ever mutates this table.
model AuditLog {
  id          String   @id @default(cuid())
  orgId       String?  @map("org_id")
  actorUserId String?  @map("actor_user_id")
  actorType   String   @default("user") // "user" | "system" | "agent"
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  ip          String?
  userAgent   String?  @map("user_agent")
  meta        Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([orgId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([orgId, action, createdAt])
  @@map("audit_logs")
}

// A verified email domain claims one org for SSO (SAML/OIDC via Clerk).
model SsoConnection {
  id                String   @id @default(cuid())
  orgId             String   @map("org_id")
  clerkConnectionId String   @map("clerk_connection_id")
  domain            String
  protocol          String // "saml" | "oidc"
  status            String   @default("pending") // pending | active | disabled
  enforceSso        Boolean  @default(false) @map("enforce_sso")
  breakGlassUserIds String[] @default([]) @map("break_glass_user_ids")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([domain])
  @@index([orgId])
  @@map("sso_connections")
}

// Org-controlled lifecycle for synced + derived data. null = keep forever.
model RetentionPolicy {
  id                   String   @id @default(cuid())
  orgId                String   @unique @map("org_id")
  emailDays            Int?     @map("email_days")
  slackDays            Int?     @map("slack_days")
  auditDays            Int      @default(365) @map("audit_days")
  derivedFollowsSource Boolean  @default(true) @map("derived_follows_source")
  // Set to updatedAt + 72h when a policy is first tightened (grace period).
  effectiveAt          DateTime? @map("effective_at") @db.Timestamptz
  updatedByUserId      String   @map("updated_by_user_id")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("retention_policies")
}

// Rows matching an active hold are never purged.
model LegalHold {
  id              String   @id @default(cuid())
  orgId           String   @map("org_id")
  name            String
  createdByUserId String   @map("created_by_user_id")
  active          Boolean  @default(true)
  scope           Json     @default("{}") // { userIds?, sharedInboxIds?, before?, after? }
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, active])
  @@map("legal_holds")
}

// Pre-aggregated daily org metrics for the analytics dashboard.
model DailyOrgStat {
  id     String   @id @default(cuid())
  orgId  String   @map("org_id")
  date   DateTime @db.Date
  metric String
  value  Int      @default(0)
  dims   Json     @default("{}")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, date, metric, dims])
  @@index([orgId, metric, date])
  @@map("daily_org_stats")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 5 — AI Chat History
// ─────────────────────────────────────────────────────────────────────────────

model ChatConversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String   @default("New Chat")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String   // "user" | "assistant" | "system" | "data"
  content        String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Asc)])
  @@map("chat_messages")
}
