# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.
#
# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.
#
# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# ─────────────────────────────────────────────────────────────────────────────
# Database (Supabase Postgres)
# https://www.prisma.io/docs/orm/overview/databases/supabase
# Use the transaction-mode pooler (port 6543) for the app, and the session-mode
# pooler (port 5432) as DIRECT_URL for Prisma migrations.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────────────────────
# Corsair
# Key Encryption Key (KEK) — encrypts every stored OAuth credential.
# Generate one with:  openssl rand -base64 32
# WARNING: if you lose this key you lose access to all stored credentials.
# ─────────────────────────────────────────────────────────────────────────────
CORSAIR_KEK="<run: openssl rand -base64 32>"

# ─────────────────────────────────────────────────────────────────────────────
# App
# Public base URL of this app. Used to build the OAuth redirect URIs.
# Local dev: http://localhost:3000   Production: https://your-domain.com
# ─────────────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth (shared by the Gmail and Google Calendar Corsair plugins)
# 1. Google Cloud Console -> APIs & Services -> Credentials
#    https://console.cloud.google.com/apis/credentials
# 2. Create an "OAuth client ID" of type "Web application".
# 3. Enable the "Gmail API" and "Google Calendar API" under APIs & Services -> Library.
# 4. Under "Authorized redirect URIs", register BOTH of these (match APP_URL):
#      http://localhost:3000/api/integrations/gmail/callback
#      http://localhost:3000/api/integrations/googlecalendar/callback
#    (and the https:// production equivalents when you deploy)
# 5. After setting these, store the credentials with Corsair once:
#      bun run corsair:setup
#    (reads GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from .env and stores them
#     encrypted at the integration level — shared across all tenants)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="<your-google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<your-google-oauth-client-secret>"

# ─────────────────────────────────────────────────────────────────────────────
# Microsoft (Outlook) + Slack OAuth — Phase 3 plugins. Optional: the connect
# flow for each is disabled until its credentials are stored with Corsair
# (extend `bun run corsair:setup`). Outlook is personal + org; Slack is org-only.
#   Outlook redirect URI:  {APP_URL}/api/integrations/outlook/callback
#   Slack redirect URI:    {APP_URL}/api/integrations/slack/callback
# ─────────────────────────────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""


SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Clerk authentication
# Dashboard -> API keys:  https://dashboard.clerk.com/last-active?path=api-keys
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ─────────────────────────────────────────────────────────────────────────────
# Firecrawl — used by the design-clone skill / CLI (not required by the app).
# Get a key at https://www.firecrawl.dev (dashboard → API keys).
# ─────────────────────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI — Vercel AI SDK provider (@ai-sdk/openai). Used for email embeddings
# (text-embedding-3-small) and priority triage. Optional: features degrade
# gracefully if unset.
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ─────────────────────────────────────────────────────────────────────────────
# Supabase Realtime (browser). Project URL + a publishable/anon key.
# Dashboard → Project Settings → API.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Gmail Pub/Sub topic (full path) for push notifications. See WEBHOOKS.md.
GMAIL_PUBSUB_TOPIC="projects/<gcp-project>/topics/gmail-push"

# ─────────────────────────────────────────────────────────────────────────────
# Command channels (Phase 10) — optional. See CHANNELS.md.
# Telegram: create a bot via @BotFather; set a webhook secret you choose.
# WhatsApp: Meta Cloud API (token, phone number id, a verify token you choose,
# and the app secret used to sign X-Hub-Signature-256).
# ─────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Clerk Organizations webhook (Phase 3 — Teams)
# Dashboard → Webhooks → add endpoint `/api/webhooks/clerk`, subscribe to
# organization.* and organizationMembership.* events, then copy the signing
# secret here. Optional: team sync is disabled when unset.
# ─────────────────────────────────────────────────────────────────────────────
CLERK_WEBHOOK_SECRET="whsec_awIsg9n5ZbmHexVqVwI+OiQc4eUxlPwW"

# ─────────────────────────────────────────────────────────────────────────────
# Stripe billing (Phase 3). Server SDK + Stripe-hosted Checkout/Portal only.
# Dashboard → Developers → API keys (secret key) and Webhooks (signing secret
# for the `/api/webhooks/stripe` endpoint). Create per-seat recurring Prices for
# Pro and Business (monthly + yearly) and paste their price ids below.
# Optional: billing is disabled when unset.
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""
STRIPE_PRICE_BUSINESS_YEARLY=""

# ─────────────────────────────────────────────────────────────────────────────
# Phase 4 — Enterprise
# Stripe Enterprise plan prices (per-seat). Optional.
STRIPE_PRICE_ENTERPRISE_MONTHLY=""
STRIPE_PRICE_ENTERPRISE_YEARLY=""
# Supabase service-role key — server-side Storage for audit/GDPR exports.
# Dashboard → Project Settings → API → service_role secret. Optional: exports
# compute but skip the signed URL when unset.
SUPABASE_SERVICE_ROLE_KEY=""
# NOTE: orgs that enforce SSO must add a Clerk custom session token claim
#   { "strategy": "{{...}}" }
# so the server can detect SSO vs non-SSO sessions (see SECURITY.md).

# ─────────────────────────────────────────────────────────────────────────────
# Phase 0 — Observability + rate limiting. All optional.
# SENTRY_DSN: enables error capture (lazy init; no build wizard). See docs/observability.md.
# PAGERDUTY_ROUTING_KEY: Events API v2 routing key; pages on-call for
#   pipeline-fatal Inngest failures only.
# BACKFILL_CONCURRENCY / BACKFILL_THROTTLE_PER_MIN: per-user backfill limits
#   (defaults 2 and 60/min).
# ─────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=""
PAGERDUTY_ROUTING_KEY=""
BACKFILL_CONCURRENCY=""
BACKFILL_THROTTLE_PER_MIN=""
