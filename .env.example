# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.
#
# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.
#
# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# ─────────────────────────────────────────────────────────────────────────────
# Database (Supabase Postgres)
# https://www.prisma.io/docs/orm/overview/databases/supabase
# Use the transaction-mode pooler (port 6543) for the app, and the session-mode
# pooler (port 5432) as DIRECT_URL for Prisma migrations.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────────────────────
# Corsair
# Key Encryption Key (KEK) — encrypts every stored OAuth credential.
# Generate one with:  openssl rand -base64 32
# WARNING: if you lose this key you lose access to all stored credentials.
# ─────────────────────────────────────────────────────────────────────────────
CORSAIR_KEK="<run: openssl rand -base64 32>"

# ─────────────────────────────────────────────────────────────────────────────
# App
# Public base URL of this app. Used to build the OAuth redirect URIs.
# Local dev: http://localhost:3000   Production: https://your-domain.com
# ─────────────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth (shared by the Gmail and Google Calendar Corsair plugins)
# 1. Google Cloud Console -> APIs & Services -> Credentials
#    https://console.cloud.google.com/apis/credentials
# 2. Create an "OAuth client ID" of type "Web application".
# 3. Enable the "Gmail API" and "Google Calendar API" under APIs & Services -> Library.
# 4. Under "Authorized redirect URIs", register BOTH of these (match APP_URL):
#      http://localhost:3000/api/integrations/gmail/callback
#      http://localhost:3000/api/integrations/googlecalendar/callback
#    (and the https:// production equivalents when you deploy)
# 5. After setting these, store the credentials with Corsair once:
#      bun run corsair:setup
#    (reads GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from .env and stores them
#     encrypted at the integration level — shared across all tenants)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="<your-google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<your-google-oauth-client-secret>"

# ─────────────────────────────────────────────────────────────────────────────
# Clerk authentication
# Dashboard -> API keys:  https://dashboard.clerk.com/last-active?path=api-keys
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ─────────────────────────────────────────────────────────────────────────────
# Firecrawl — used by the design-clone skill / CLI (not required by the app).
# Get a key at https://www.firecrawl.dev (dashboard → API keys).
# ─────────────────────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY="fc-..."
